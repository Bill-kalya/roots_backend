# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/roots_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CART_TTL=604800  # 7 days in seconds

# JWT
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://shoproots.africa", "https://www.shoproots.africa"]
TRUSTED_HOSTS=["api.shoproots.africa"]

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@roots.com

# Frontend URL used to build verification/reset links
FRONTEND_URL=http://localhost:5173

# Public backend API URL used for fully-qualified asset links
PUBLIC_API_BASE_URL=http://localhost:8000

# Admin
ADMIN_EMAIL=admin@roots.com